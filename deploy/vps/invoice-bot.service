[Unit]
Description=Invoice Telegram bot (Termodinamika — База поставщиков)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/invoice_bot
EnvironmentFile=/opt/invoice_bot/.env
Environment=PYTHONUTF8=1
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
ExecStart=/opt/invoice_bot/.venv/bin/python /opt/invoice_bot/bot.py
Restart=always
RestartSec=5
TimeoutStopSec=20
MemoryMax=700M

[Install]
WantedBy=multi-user.target
